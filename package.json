{
  "name": "dbot",
  "version": "1.0.0",
  "description": "Multi-channel Discord Music & Soundboard Bot with 5 Voice Agents, Real-Time Web Dashboard, SQLite + Drizzle ORM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [
    "discord",
    "bot",
    "discordjs",
    "typescript",
    "sqlite",
    "drizzle"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^5.2.1",
    "better-sqlite3": "13.2.0",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.4",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.13.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
