# ========================================================
# ОСНОВНОЙ БОТ (Координатор, приём команд, веб-панель)
# ========================================================
DISCORD_TOKEN=your_main_bot_token_here
CLIENT_ID=your_main_client_id_here
GUILD_ID=your_test_guild_id_here

# ========================================================
# ГОЛОСОВЫЕ ВОЙС-ВОРКЕРЫ (5 агентов для разных каналов)
# Создайте 5 ботов в Discord Developer Portal и вставьте их токены
# ========================================================
WORKER_TOKEN_1=
WORKER_TOKEN_2=
WORKER_TOKEN_3=
WORKER_TOKEN_4=
WORKER_TOKEN_5=

# Префикс текстовых команд (по умолчанию +)
PREFIX=+

# ========================================================
# НАСТРОЙКИ СЕРВЕРА / ВЕБ-ПАНЕЛИ (для хостинга Oracle Cloud)
# ========================================================
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

# Опционально: Discord OAuth2 Client Secret (без него работает вход по команде /web)
DISCORD_CLIENT_SECRET=

# Опционально: ключи Spotify API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
